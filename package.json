{
  "name": "tiermaker-ru-mcp",
  "version": "0.5.0",
  "description": "TierMaker.ru MCP: create tier lists, render PNG and continue editing on tiermaker.ru",
  "mcpName": "io.github.tiermaker/tiermaker-ru-mcp",
  "author": "TierMaker.ru contributors",
  "homepage": "https://github.com/tiermaker/tiermaker-ru-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiermaker/tiermaker-ru-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tiermaker/tiermaker-ru-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "tiermaker-ru-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json",
    "SECURITY.md",
    "distribution",
    "scripts"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test evals && tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "eval": "npm run build && tsc -p tsconfig.evals.json && node dist-evals/evals/run.js",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "start:http": "node dist/http.js",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tier-list",
    "tiermaker",
    "ranking",
    "claude",
    "ai-agent"
  ],
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@resvg/resvg-js": "2.6.2",
    "image-size": "2.1.0",
    "ipaddr.js": "^2.2.0",
    "satori": "0.33.5",
    "sharp": "0.35.5",
    "undici": "^7.16.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@types/node": "22.15.21",
    "eslint": "9.27.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
